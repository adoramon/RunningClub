.battle-card { margin:8rpx 0 24rpx; overflow:hidden; border-radius:28rpx; background:#1F6F54; box-shadow:0 14rpx 34rpx rgba(24,87,64,.16); }
.hero { position:relative; height:400rpx; overflow:hidden; background:#1F6F54; }
.hero-image { width:100%; height:100%; }
.hero-shade { position:absolute; inset:0; background:linear-gradient(180deg,rgba(20,42,32,.04) 24%,#1F6F54 100%),linear-gradient(90deg,rgba(20,42,32,.68),rgba(20,42,32,.02)); }
.hero-content { position:absolute; z-index:1; top:30rpx; right:28rpx; bottom:28rpx; left:30rpx; color:#fff; }
.brand-row,.summary-layout,.fund-card,.member-progress { display:flex; align-items:center; }
.brand-logo { width:58rpx; height:58rpx; margin-right:14rpx; }
.brand-name { font-size:28rpx; font-weight:800; letter-spacing:4rpx; }
.brand-subtitle { margin-top:2rpx; font-size:17rpx; letter-spacing:3rpx; opacity:.75; }
.hero-eyebrow { margin-top:48rpx; color:rgba(255,255,255,.76); }
.hero-title { margin:12rpx 0; font-size:52rpx; color:#fff; }
.hero-copy { font-size:24rpx; color:rgba(255,255,255,.85); }

.progress-card { padding:12rpx 24rpx 0; overflow:hidden; background:linear-gradient(180deg,#1F6F54,#236E54); color:#fff; }
.summary-ring { display:flex; flex:0 0 132rpx; align-items:center; justify-content:center; width:132rpx; height:132rpx; border-radius:50%; box-shadow:0 0 0 6rpx rgba(141,224,168,.24); }
.summary-ring-core { display:flex; align-items:center; justify-content:center; width:96rpx; height:96rpx; border-radius:50%; background:#F7FBF6; color:#176043; font-size:24rpx; font-weight:900; }
.summary-details { min-width:0; margin-left:20rpx; flex:1; }
.summary-heading { display:flex; align-items:baseline; justify-content:space-between; gap:12rpx; }
.label { font-size:30rpx; font-weight:900; white-space:nowrap; }
.progress-people { color:rgba(255,255,255,.8); font-size:19rpx; white-space:nowrap; }
.summary-totals { display:flex; align-items:flex-end; margin-top:12rpx; }
.summary-metric { min-width:0; flex:1; }
.summary-vs { flex:0 0 46rpx; align-self:center; color:rgba(255,255,255,.42); font-family:Georgia,"Times New Roman",serif; font-size:27rpx; font-style:italic; font-weight:700; letter-spacing:-1rpx; text-align:center; transform:skewX(-8deg); }
.number { font-size:42rpx; font-weight:900; }
.unit { margin-left:3rpx; font-size:20rpx; font-weight:700; }
.summary-metric view { margin-top:1rpx; color:rgba(255,255,255,.66); font-size:18rpx; }
.summary-target { box-sizing:border-box; text-align:right; }

.lifetime-inline { margin:20rpx -24rpx 0; padding:18rpx 24rpx 22rpx; border-radius:22rpx 22rpx 0 0; background:#F6F9F6; color:#6E8173; }
.lifetime-inline-heading { display:flex; align-items:baseline; flex-wrap:wrap; }
.lifetime-inline-label { color:#8B998E; font-size:20rpx; }
.lifetime-inline-amount { margin-left:10rpx; color:#587565; font-size:36rpx; font-weight:800; }
.lifetime-inline-amount text { font-size:19rpx; font-weight:600; }
.lifetime-inline-duration { margin-left:12rpx; color:#98A49A; font-size:19rpx; }
.lifetime-inline-loading { margin:18rpx -24rpx 0; padding:20rpx 24rpx; border-radius:22rpx 22rpx 0 0; background:#F6F9F6; color:#98A49A; font-size:21rpx; }
.comparison-grid { display:flex; flex-wrap:wrap; margin:12rpx -5rpx -5rpx; }
.comparison { box-sizing:border-box; width:50%; padding:5rpx; }
.comparison-inner { display:flex; align-items:baseline; justify-content:space-between; padding:12rpx; border-radius:12rpx; background:#EDF3EE; }
.comparison-label { min-width:0; color:#97A49A; font-size:18rpx; white-space:nowrap; }
.comparison-value { flex:0 0 auto; margin-left:8rpx; color:#63816E; font-size:23rpx; font-weight:700; white-space:nowrap; }

.fund-card { justify-content:space-between; padding:26rpx 30rpx; margin-top:18rpx; }
.fund-label { color:#788078; font-size:22rpx; }
.fund-amount { margin-top:8rpx; color:#C64D45; font-size:40rpx; font-weight:800; }
.fund-added { margin-top:8rpx; color:#1F6F54; font-size:34rpx; font-weight:800; }
.fund-amount text,.fund-added text { font-size:20rpx; font-weight:500; }
.fund-divider { width:1rpx; height:68rpx; background:#E8EAE5; }
.submit-guide { display:flex; align-items:center; justify-content:space-between; margin-top:20rpx; padding:26rpx 28rpx; border-radius:20rpx; background:#FFF4D9; color:#624B16; }
.submit-guide-title { font-size:29rpx; font-weight:800; }
.submit-guide-copy { margin-top:6rpx; color:#8A753C; font-size:22rpx; }
.submit-guide-action { color:#8A6819; font-size:24rpx; font-weight:800; }

.member { display:flex; align-items:center; min-height:118rpx; border-bottom:1rpx solid #F0F0EC; }
.member:last-child { border:0; }
.rank { width:42rpx; color:#90968E; font-weight:700; }
.avatar { display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; overflow:hidden; border-radius:50%; background:#DCECE2; color:#1F6F54; font-weight:800; }
.avatar image { width:100%; height:100%; }
.member-info { margin-left:18rpx; flex:1; font-weight:700; }
.member-meta { margin-top:4rpx; font-size:22rpx; font-weight:400; }
.member-progress { gap:12rpx; }
.ring { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; border-radius:50%; }
.ring-core { display:flex; align-items:center; justify-content:center; width:50rpx; height:50rpx; border-radius:50%; background:#fff; font-size:15rpx; font-weight:800; }
.member-km { min-width:78rpx; text-align:right; font-size:28rpx; font-weight:800; }
.member-km text { font-size:19rpx; }
.status-completed { color:#899088; }.status-paid { color:#1F8B58; font-weight:700; }.status-action { color:#C7473F; font-weight:700; }.status-muted { color:#A3A8A3; }
.tone-deep-green .ring-core { color:#166C43; }.tone-light-green .ring-core { color:#65A36F; }.tone-deep-yellow .ring-core { color:#B98411; }.tone-light-yellow .ring-core { color:#B58B18; }.tone-red .ring-core { color:#D85C4F; }.tone-deep-red .ring-core { color:#A63A34; }
.mine { padding:2rpx 8rpx; border-radius:8rpx; background:#E4F0E9; color:#1F6F54; font-size:19rpx; }
.unregistered { margin-left:6rpx; color:#A3A8A3; font-size:18rpx; font-weight:400; }
.gate { padding-top:130rpx; }.gate-logo { width:150rpx; height:150rpx; margin-bottom:30rpx; }
