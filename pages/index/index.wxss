.hero { position:relative; height:430rpx; margin:8rpx 0 24rpx; overflow:hidden; border-radius:28rpx; background:#1F6F54; }.hero-image { width:100%; height:100%; }.hero-shade { position:absolute; inset:0; background:linear-gradient(90deg,rgba(20,42,32,.68) 0%,rgba(20,42,32,.30) 52%,rgba(20,42,32,.02) 100%); }.hero-content { position:absolute; z-index:1; top:30rpx; right:28rpx; bottom:28rpx; left:30rpx; color:#fff; }.brand-row { display:flex; align-items:center; }.brand-logo { width:58rpx; height:58rpx; margin-right:14rpx; }.brand-name { font-size:28rpx; font-weight:800; letter-spacing:4rpx; }.brand-subtitle { margin-top:2rpx; font-size:17rpx; letter-spacing:3rpx; opacity:.75; }.hero-eyebrow { margin-top:48rpx; color:rgba(255,255,255,.76); }.hero-title { margin:12rpx 0; font-size:52rpx; color:#fff; }.hero-copy { font-size:24rpx; color:rgba(255,255,255,.85); }.progress-card { padding:24rpx 28rpx; background:#1F6F54; color:white; }.row { display:flex; justify-content:space-between; align-items:center; }.label { font-size:28rpx; font-weight:700; }.progress-people { color:rgba(255,255,255,.74); font-size:21rpx; }.track { height:12rpx; margin:18rpx 0; overflow:hidden; border-radius:999rpx; background:rgba(255,255,255,.25); }.fill { height:100%; border-radius:999rpx; background:#E7C668; animation:progressPulse 2.4s ease-in-out infinite; }.totals .muted { color:rgba(255,255,255,.7); }.number { font-size:42rpx; font-weight:800; }.unit { font-size:22rpx; }.fund-card { display:flex; align-items:center; justify-content:space-between; padding:26rpx 30rpx; margin-top:18rpx; }.fund-label { color:#788078; font-size:22rpx; }.fund-amount { margin-top:8rpx; color:#C64D45; font-size:40rpx; font-weight:800; }.fund-added { margin-top:8rpx; color:#1F6F54; font-size:34rpx; font-weight:800; }.fund-amount text,.fund-added text { font-size:20rpx; font-weight:500; }.fund-divider { width:1rpx; height:68rpx; background:#E8EAE5; }.submit-guide { display:flex; align-items:center; justify-content:space-between; margin-top:20rpx; padding:26rpx 28rpx; border-radius:20rpx; background:#FFF4D9; color:#624B16; }.submit-guide-title { font-size:29rpx; font-weight:800; }.submit-guide-copy { margin-top:6rpx; color:#8A753C; font-size:22rpx; }.submit-guide-action { color:#8A6819; font-weight:800; font-size:24rpx; }.member { display:flex; align-items:center; min-height:118rpx; border-bottom:1rpx solid #F0F0EC; }.member:last-child { border:0; }.rank { width:42rpx; color:#90968E; font-weight:700; }.avatar { display:flex; align-items:center; justify-content:center; width:58rpx; height:58rpx; overflow:hidden; border-radius:50%; background:#DCECE2; color:#1F6F54; font-weight:800; }.avatar image { width:100%; height:100%; }.member-info { margin-left:18rpx; flex:1; font-weight:700; }.member-meta { margin-top:4rpx; color:#899088; font-size:22rpx; font-weight:400; }.member-progress { display:flex; align-items:center; gap:12rpx; }.ring { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; border-radius:50%; }.ring-core { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; border-radius:50%; background:#fff; color:#1F6F54; font-size:18rpx; font-weight:800; }.member-km { min-width:74rpx; text-align:right; font-size:28rpx; font-weight:800; }.member-km text { font-size:19rpx; }.mine { padding:2rpx 8rpx; border-radius:8rpx; background:#E4F0E9; color:#1F6F54; font-size:19rpx; }.unregistered { margin-left:6rpx; color:#A3A8A3; font-size:18rpx; font-weight:400; }.gate { padding-top:130rpx; }.gate-logo { width:150rpx; height:150rpx; margin-bottom:30rpx; } @keyframes progressPulse { 0%,100% { filter:brightness(1); transform:translateX(-2%); } 50% { filter:brightness(1.16); transform:translateX(0); } }
