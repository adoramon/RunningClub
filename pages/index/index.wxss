.hero { position:relative; height:430rpx; margin:8rpx 0 28rpx; overflow:hidden; border-radius:28rpx; background:#1F6F54; }.hero-image { width:100%; height:100%; }.hero-shade { position:absolute; inset:0; background:linear-gradient(90deg,rgba(20,42,32,.68) 0%,rgba(20,42,32,.30) 52%,rgba(20,42,32,.02) 100%); }.hero-content { position:absolute; z-index:1; top:30rpx; right:28rpx; bottom:28rpx; left:30rpx; color:#fff; }.brand-row { display:flex; align-items:center; }.brand-logo { width:58rpx; height:58rpx; margin-right:14rpx; }.brand-name { font-size:28rpx; font-weight:800; letter-spacing:4rpx; }.brand-subtitle { margin-top:2rpx; font-size:17rpx; letter-spacing:3rpx; opacity:.75; }.hero-eyebrow { margin-top:48rpx; color:rgba(255,255,255,.76); }.hero-title { margin:12rpx 0; font-size:52rpx; color:#fff; }.hero-copy { font-size:24rpx; color:rgba(255,255,255,.85); }.progress-card { background: #1F6F54; color: white; }.row { display:flex; justify-content:space-between; align-items:center; }.label { font-size: 28rpx; font-weight:700; }.value { font-size:38rpx; font-weight:800; }.track { height: 14rpx; border-radius: 8rpx; background: rgba(255,255,255,.25); margin: 28rpx 0; overflow:hidden; }.fill { height:100%; border-radius:8rpx; background:#E7C668; }.totals .muted { color:rgba(255,255,255,.7); }.number { font-size:48rpx; font-weight:800; }.unit { font-size:24rpx; }.progress-note { margin-top:20rpx; color:rgba(255,255,255,.68); font-size:21rpx; }.notice { display:flex; align-items:center; justify-content:space-between; margin-top:24rpx; }.notice-title { font-size:29rpx; font-weight:800; margin-bottom:4rpx; }.small-btn { padding:0 22rpx; margin:0; font-size:25rpx; line-height:66rpx; background:#E4F0E9; color:#1F6F54; border-radius:12rpx; }.small-btn::after { border:none; }.member { display:flex; align-items:center; min-height:104rpx; border-bottom:1rpx solid #F0F0EC; }.member:last-child { border:0; }.rank { width:42rpx; color:#90968E; font-weight:700; }.avatar { width:54rpx; height:54rpx; line-height:54rpx; text-align:center; border-radius:50%; background:#DCECE2; color:#1F6F54; font-weight:800; }.member-info { margin-left:18rpx; flex:1; font-weight:700; }.member-meta { font-size:22rpx; color:#899088; font-weight:400; margin-top:4rpx; }.member-km { font-weight:800; font-size:31rpx; }.member-km text { font-size:20rpx; }.mine { color:#1F6F54; background:#E4F0E9; font-size:19rpx; padding:2rpx 8rpx; border-radius:8rpx; }.gate { padding-top:130rpx; }.gate-logo { width:150rpx; height:150rpx; margin-bottom:30rpx; }
