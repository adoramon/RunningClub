<view class="page" wx:if="{{authorized && dashboard}}">
  <view class="battle-card">
    <view class="hero">
      <image class="hero-image" src="/assets/images/marathon-hero.jpg" mode="aspectFill" />
      <view class="hero-shade"></view>
      <view class="hero-content">
        <view class="brand-row"><image class="brand-logo" src="/assets/images/dongcheng-xijiu-logo.png" mode="aspectFit" /><view><view class="brand-name">东成西就</view><view class="brand-subtitle">RUNNING CLUB</view></view></view>
        <view class="eyebrow hero-eyebrow">{{dashboard.summaryMonth}} · 上月团队总结</view>
        <view class="title hero-title"><text>一起把承诺</text><text class="hero-title-line">跑成日常</text></view>
        <view class="hero-copy">每月第一天，提交上月跑量记录。</view>
      </view>
    </view>
    <view class="progress-card">
      <view class="summary-layout"><view class="summary-ring" style="{{dashboard.summaryRingStyle}}"><view class="summary-ring-core">{{dashboard.completionPct}}%</view></view><view class="summary-details"><view class="summary-heading"><view class="label">上月团队完成情况</view><view class="progress-people">{{dashboard.targetMemberCount}}人已承诺 · {{dashboard.actualMemberCount}}人已提交</view></view><view class="summary-totals"><view class="summary-metric summary-actual"><text class="number">{{dashboard.totalActualText}}</text><text class="unit">km</text><view>上月全员实际跑量</view></view><view class="summary-divider"></view><view class="summary-metric summary-target"><text class="number">{{dashboard.totalTargetText}}</text><text class="unit">km</text><view>全员总承诺跑量</view></view></view></view></view>
      <view wx:if="{{dashboard.lifetime}}" class="lifetime-inline"><view class="lifetime-inline-heading"><view class="lifetime-inline-label">东成西就累计跑量</view><view class="lifetime-inline-amount">{{dashboard.lifetime.totalKmText}} <text>km</text></view><view class="lifetime-inline-duration">{{dashboard.lifetime.operatingText}}</view></view><view class="comparison-grid compact"><view wx:for="{{dashboard.lifetime.comparisons}}" wx:key="label" class="comparison"><view class="comparison-inner"><view class="comparison-label">{{item.label}}</view><view class="comparison-value">{{item.value}}</view></view></view></view></view>
      <view wx:else class="lifetime-inline-loading">正在汇总历史总里程…</view>
    </view>
  </view>

  <view class="card fund-card" bindtap="goFundLedger">
    <view><view class="fund-label">公积金当前余额</view><view class="fund-amount">{{dashboard.fundBalanceText}} <text>元</text></view></view>
    <view class="fund-divider"></view>
    <view><view class="fund-label">上月新增公积金</view><view class="fund-added">+{{dashboard.fundAddedLastMonthText}} <text>元</text></view></view>
  </view>
  <view wx:if="{{!dashboard.isReviewDemo}}" class="fund-entry" bindtap="goFundLedger"><text>公积金收支公示</text><text>查看明细 →</text></view>

  <view wx:if="{{dashboard.isAdmin && (dashboard.pendingReviewCount || dashboard.missingSubmissionCount)}}" class="admin-review-alert" bindtap="goReview"><view class="admin-review-badge">审</view><view class="admin-review-copy"><view wx:if="{{dashboard.pendingReviewCount}}">有 {{dashboard.pendingReviewCount}} 条跑量等待审核</view><view wx:if="{{dashboard.missingSubmissionCount}}">有 {{dashboard.missingSubmissionCount}} 人上月尚未提交</view><view>可核验截图、请假或确认缴纳公积金</view></view><view class="admin-review-action">去管理 →</view></view>

  <view wx:if="{{!dashboard.myLastMonthSubmitted}}" class="submit-guide" bindtap="goUpload"><view><view class="submit-guide-title">上月跑量尚未提交</view><view class="submit-guide-copy">上传上月运动软件记录，补全上月排名。</view></view><view class="submit-guide-action">去提交 →</view></view>
  <view wx:if="{{dashboard.myPendingFundPayment}}" class="fund-payment-guide"><view class="fund-payment-icon">¥</view><view class="fund-payment-copy"><view>上月跑量未达承诺，请尽快缴纳公积金</view><view>实际 {{dashboard.myPendingFundPayment.actualKm}} km / 承诺 {{dashboard.myPendingFundPayment.targetText}} km · 应缴 ¥{{dashboard.myPendingFundPayment.fundDueText}}</view></view></view>

  <view class="section-title">上月跑量排名</view>
  <view class="card leaderboard">
    <view class="member" wx:for="{{dashboard.ranking}}" wx:key="memberId" bindtap="goMemberAnalysis" data-member-id="{{item.memberId}}">
      <text class="rank">{{index + 1}}</text><view class="avatar"><image wx:if="{{item.avatarUrl || item.avatarFileId}}" src="{{item.avatarUrl || item.avatarFileId}}" mode="aspectFill"/><text wx:else>{{item.displayName.slice(0,1)}}</text></view>
      <view class="member-info"><view>{{item.displayName}} <text wx:if="{{item.isMe}}" class="mine">我</text><text wx:if="{{!item.registered}}" class="unregistered">○ 未注册</text></view><view class="member-meta {{item.actualNoteClass}}">承诺 {{item.targetText}} km · {{item.actualNote}}</view></view>
      <view class="member-progress"><view class="member-km">{{item.actualText}}<text wx:if="{{item.actualText !== '—'}}"> km</text></view><view class="ring {{item.toneClass}}" style="{{item.ringStyle}}"><view class="ring-core">{{item.completionPct}}%</view></view></view>
    </view>
  </view>
</view>
<view wx:else class="page gate"><image class="gate-logo" src="/assets/images/dongcheng-xijiu-logo.png" mode="aspectFit" /><view class="title"><text>正在验证</text><text>跑团身份</text></view><view class="muted">完成微信昵称、头像与历史艺名绑定后即可进入。</view></view>
