<view class="page" wx:if="{{authorized && dashboard}}">
  <view class="hero">
    <image class="hero-image" src="/assets/images/marathon-hero.jpg" mode="aspectFill" />
    <view class="hero-shade"></view>
    <view class="hero-content">
      <view class="brand-row"><image class="brand-logo" src="/assets/images/dongcheng-xijiu-logo.png" mode="aspectFit" /><view><view class="brand-name">东成西就</view><view class="brand-subtitle">RUNNING CLUB</view></view></view>
      <view class="eyebrow hero-eyebrow">{{dashboard.summaryMonth}} · 上月团队总结</view>
      <view class="title hero-title">一起把承诺<br/>跑成日常</view>
      <view class="hero-copy">每月第一天，提交上月跑量记录。</view>
    </view>
  </view>

  <view class="card progress-card">
    <view class="row"><text class="label">上月团队完成情况</text><text class="value">{{pct}}%</text></view>
    <view class="track"><view class="fill" style="width: {{pct}}%"></view></view>
    <view class="row totals"><view><text class="number">{{dashboard.totalActualText}}</text><text class="unit"> km 实际跑量</text></view><text class="muted">承诺 {{dashboard.totalTargetText}} km</text></view>
    <view class="progress-note">{{dashboard.totalMembers}} 人历史记录 · {{dashboard.targetMemberCount}} 人有承诺 · {{dashboard.actualMemberCount}} 人有可统计跑量</view>
  </view>

  <view class="card notice">
    <view><view class="notice-title">本月承诺自动继承</view><view class="muted" wx:if="{{dashboard.profile.inheritedTargetKm !== null}}">{{dashboard.currentMonth}} 承诺 {{dashboard.profile.inheritedTargetKm}} km，继承自历史台账{{dashboard.profile.inheritedFromMonth === dashboard.currentMonth ? '' : '（最近一次：' + dashboard.profile.inheritedFromMonth + '）'}}。</view><view class="muted" wx:else>历史台账未找到你的承诺跑量，请联系管理员补录。</view></view>
    <button class="small-btn" bindtap="goUpload">去提交</button>
  </view>

  <view class="section-title">{{dashboard.summaryMonth}} 全体历史记录</view>
  <view class="card leaderboard">
    <view class="member" wx:for="{{dashboard.members}}" wx:key="memberId">
      <text class="rank">{{index + 1}}</text><view class="avatar">{{item.alias.slice(0,1)}}</view>
      <view class="member-info"><view>{{item.alias}} <text wx:if="{{item.isMe}}" class="mine">我</text></view><view class="member-meta">承诺 {{item.targetText}} km · {{item.actualNote}}</view></view>
      <view class="member-km">{{item.actualText}}<text wx:if="{{item.actualText !== '—'}}"> km</text></view>
    </view>
  </view>
</view>
<view wx:else class="page gate"><image class="gate-logo" src="/assets/images/dongcheng-xijiu-logo.png" mode="aspectFit" /><view class="title">正在验证<br/>跑团身份</view><view class="muted">完成微信昵称、头像与历史艺名绑定后即可进入。</view></view>
