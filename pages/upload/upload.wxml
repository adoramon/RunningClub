<view class="page">
  <view class="page-brand"><image class="page-logo" src="/assets/images/dongcheng-xijiu-logo.png" mode="aspectFit" /><view class="eyebrow">{{month}} · PROOF OF RUN</view></view>
  <view class="title"><text>提交上月</text><text>运动记录</text></view>
  <view class="tip"><text>●</text> 上传月度截图，系统先识别原文，再分析并换算等效跑量。</view>

  <view class="card form-card" wx:if="{{!submission || submission.reviewStatus === 'recognition_failed' || submission.reviewStatus === 'cancelled' || submission.reviewStatus === 'withdrawn' || submission.reviewStatus === 'voided'}}">
    <view class="field-label">上月运动记录截图 <text class="image-count">{{images.length}} / 3 张</text></view>
    <view class="image-picker {{images.length ? 'has-images' : ''}}" bindtap="chooseImages">
      <view wx:if="{{images.length}}" class="image-grid"><image wx:for="{{images}}" wx:key="path" src="{{item.path}}" mode="aspectFill"/></view>
      <view wx:else><view class="plus">＋</view><view>从相册或相机选择</view><view class="picker-subtitle">可一次选择最多 3 张</view></view>
    </view>
    <view wx:if="{{images.length}}" class="replace-images" bindtap="chooseImages">重新选择截图</view>
    <view class="recognition-note">可合并多张不同的运动记录；请勿重复上传同一份月度总量截图。支持跑步、骑行、游泳、跳绳、累计爬升。</view>
    <button class="primary-btn submit" loading="{{loading}}" bindtap="recognize">智能识别并汇总</button>
  </view>

  <view wx:if="{{submission && submission.recognitionStatus === 'recognized' && submission.reviewStatus === 'pending_member_confirmation'}}" class="card result-card">
    <view class="result-heading"><view><view class="field-label">识别结果</view><view class="result-meta">已分析 {{submission.evidenceCount || 1}} 张截图 · 置信度 {{confidenceText}}%</view></view><view class="result-tag">待确认</view></view>
    <view wx:if="{{evidenceFiles.length}}" class="proof-strip"><image wx:for="{{evidenceFiles}}" wx:key="fileId" class="proof-thumbnail" src="{{item.fileId}}" mode="aspectFill"/><view class="proof-copy">核对截图与每项识别依据</view></view>
    <view class="review-intro">请逐项核对。可修改原始数值或选择“不计入”；系统会按规则重新计算总跑量。</view>
    <view wx:for="{{reviewActivities}}" wx:key="activityIndex" class="activity-row review-row {{item.included ? '' : 'excluded'}}"><view class="activity-main"><view class="activity-name">{{item.activityLabel}} <text class="proof-index">截图 {{item.evidenceImageIndex}}</text></view><view class="activity-evidence">依据：{{item.evidence || '模型未提供文字依据'}}</view><view class="raw-editor"><input type="digit" value="{{item.rawValueText}}" data-index="{{item.activityIndex}}" bindinput="inputActivityValue" disabled="{{!item.included}}"/><text>{{item.rawUnit}}</text></view></view><view class="activity-side"><view class="activity-equivalent">{{item.included ? item.reviewEquivalentText : '—'}}<text wx:if="{{item.included}}"> km</text></view><button class="activity-toggle {{item.included ? '' : 'is-excluded'}}" data-index="{{item.activityIndex}}" bindtap="toggleActivity" disabled="{{item.invalidUnit}}">{{item.invalidUnit ? '已拦截' : (item.included ? '不计入' : '计入')}}</button></view></view>
    <view wx:if="{{submission.evidenceCount > 1}}" class="review-note">已合并多张截图，请确认不同截图没有重复展示同一份月度总量。</view>
    <view wx:if="{{submission.recognition.notes.length}}" class="review-note">{{submission.recognition.notes[0]}}</view>
    <view class="review-total"><view><view class="field-label">确认计入的等效跑量</view><view class="confirmation-tip">由上方已计入项目重新换算；确认后进入管理员审核。</view></view><view class="review-total-number">{{reviewTotalText}}<text> km</text></view></view>
    <view class="result-actions"><button class="cancel-btn" disabled="{{loading}}" bindtap="cancelRecognition">取消本次识别</button><button class="primary-btn submit confirm-btn" loading="{{loading}}" bindtap="confirm">确认并提交审核</button></view>
  </view>

  <view wx:if="{{submission && submission.reviewStatus === 'pending_admin_review'}}" class="card status-card"><view class="status-main"><view class="status-icon">✓</view><view><view class="status-title">已提交管理员审核</view><view class="status-copy">本次确认计入 {{submission.memberConfirmedEquivalentKm}} km。审核通过后才会进入月度结算。</view></view></view><button class="withdraw-submission-btn" loading="{{loading}}" bindtap="withdrawSubmission">作废本次提交并重新上传</button></view>
  <view wx:if="{{submission && submission.reviewStatus === 'recognition_failed'}}" class="error-hint">{{submission.recognition.error || '截图暂未识别成功，请更换清晰截图重试。'}}</view>
  <view wx:if="{{submission && submission.reviewStatus === 'cancelled'}}" class="cancelled-hint">上一次识别已取消，请重新选择需要汇总的截图。</view>
  <view wx:if="{{submission && submission.reviewStatus === 'withdrawn'}}" class="voided-hint">上一次待审核提交已由你作废，请重新选择截图提交。</view>
  <view wx:if="{{submission && submission.reviewStatus === 'voided'}}" class="voided-hint">上一次提交已被管理员作废：{{submission.adminVoidReason || '不符合审核要求'}}。请核对截图后重新提交。</view>
</view>
