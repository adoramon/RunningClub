.title { margin:16rpx 0 24rpx; }.tip { padding:20rpx; border-radius:14rpx; background:#FFF2D7; color:#82611C; font-size:24rpx; margin-bottom:28rpx; }.tip text { color:#D5A328; margin-right:8rpx; }.field-label { color:#56625A; font-size:26rpx; font-weight:700; }.image-picker { height:300rpx; margin-top:20rpx; border:2rpx dashed #C8D3CB; border-radius:16rpx; background:#F7FAF7; display:flex; align-items:center; justify-content:center; overflow:hidden; color:#788078; text-align:center; font-size:25rpx; }.image-picker image { width:100%; height:100%; }.plus { color:#1F6F54; font-size:54rpx; line-height:60rpx; }.distance-label { margin-top:38rpx; }.distance-input { display:flex; align-items:center; height:90rpx; border-bottom:2rpx solid #E7E8E3; }.distance-input input { flex:1; font-size:46rpx; font-weight:800; }.distance-input text { color:#1F6F54; font-weight:700; }.submit { margin-top:36rpx; }.done { text-align:center; color:#1F6F54; font-size:24rpx; padding:22rpx; }
