<view class="page">
  <view class="page-brand"><image class="page-logo" src="/assets/images/dongcheng-xijiu-logo.png" mode="aspectFit" /><view class="eyebrow">ADMIN REVIEW</view></view>
  <view class="title"><text>跑量审核</text><text>队列</text></view>
  <view class="tip"><text>●</text> 可核验截图、处理上月未提交，并按管理员核定数据保存。</view>

  <view wx:if="{{loading}}" class="empty-state"><view class="muted">正在读取待审核记录…</view></view>
  <view wx:elif="{{!reviews.length && !missingSubmissions.length && !pendingFundPayments.length}}" class="empty-state"><view class="empty-icon">✓</view><view class="empty-title">当前没有待处理事项</view><view class="muted">新提交或上月未提交的成员会出现在这里。</view></view>
  <view wx:else>
    <view wx:if="{{reviews.length}}" class="queue-section"><view class="queue-count">截图审核 · {{reviews.length}} 条</view><view wx:for="{{reviews}}" wx:key="submissionId" class="card review-card">
      <view class="member-head"><view class="avatar"><image wx:if="{{item.avatarUrl || item.avatarFileId}}" src="{{item.avatarUrl || item.avatarFileId}}" mode="aspectFill"/><text wx:else>{{item.memberName.slice(0,1)}}</text></view><view class="member-copy"><view>{{item.memberName}} <text wx:if="{{item.memberAlias && item.memberAlias !== item.memberName}}">· {{item.memberAlias}}</text></view><view>{{item.month}} · 成员已确认</view></view><view class="confirmed-km">{{item.adminTotalText}}<text> km</text></view></view>
      <view wx:if="{{item.evidenceFiles.length}}" class="proof-strip"><image wx:for="{{item.evidenceFiles}}" wx:key="fileId" class="proof-thumbnail" src="{{item.tempUrl || item.fileId}}" mode="aspectFill" data-id="{{item.submissionId}}" data-url="{{item.tempUrl}}" data-file-id="{{item.fileId}}" bindtap="previewEvidence"/></view>
      <view class="proof-hint">点击截图可查看原图</view>
      <view wx:for="{{item.activities}}" wx:key="activityIndex" class="activity-row {{item.included ? '' : 'excluded'}}"><view class="activity-main"><view class="activity-name">{{item.label}} <text>· 截图 {{item.evidenceImageIndex}}</text></view><view class="activity-evidence">{{item.evidence || '无文字依据'}}</view><view class="raw-editor"><input type="digit" value="{{item.rawValueText}}" data-id="{{item.submissionId}}" data-index="{{item.activityIndex}}" bindinput="inputActivityValue"/><text>{{item.rawUnit}}</text></view></view><view class="activity-side"><view class="activity-equivalent">{{item.reviewEquivalentText}}<text> km</text></view><button class="activity-toggle {{item.included ? '' : 'is-excluded'}}" disabled="{{item.invalidUnit}}" data-id="{{item.submissionId}}" data-index="{{item.activityIndex}}" bindtap="toggleActivity">{{item.invalidUnit ? '单位异常' : (item.included ? '已计入' : '不计入')}}</button></view></view>
      <view class="admin-total"><text>管理员核定</text><view>{{item.adminTotalText}}<text> km</text></view></view>
      <view class="void-area"><input maxlength="160" placeholder="不符合要求时，填写作废原因（成员可见）" value="{{item.voidReason}}" data-id="{{item.submissionId}}" bindinput="inputVoidReason"/></view>
      <view class="action-row"><button class="void-btn" loading="{{actingId === item.submissionId}}" data-id="{{item.submissionId}}" bindtap="voidReview">作废本次提交</button><button class="primary-btn approve-btn" loading="{{actingId === item.submissionId}}" data-id="{{item.submissionId}}" bindtap="approve">通过并保存</button></view>
    </view></view>
    <view wx:if="{{missingSubmissions.length}}" class="queue-section missing-section"><view class="queue-count">上月尚未提交 · {{missingSubmissions.length}} 人</view><view class="missing-intro">未提交不等于已缴纳。请先核验情况，再选择请假或确认到账。</view><view wx:for="{{missingSubmissions}}" wx:key="memberId" class="card missing-card"><view class="member-head"><view class="avatar"><image wx:if="{{item.avatarUrl || item.avatarFileId}}" src="{{item.avatarUrl || item.avatarFileId}}" mode="aspectFill"/><text wx:else>{{item.displayName.slice(0,1)}}</text></view><view class="member-copy"><view>{{item.displayName}} <text wx:if="{{item.alias !== item.displayName}}">· {{item.alias}}</text></view><view>{{item.month}} · 未提交跑量</view></view></view><view class="missing-metrics"><view><text>承诺跑量</text><view>{{item.targetText}}<text> km</text></view></view><view><text>应缴公积金</text><view class="fund-due">¥{{item.fundDueText}}</view></view></view><view class="fund-rule">缺口 {{item.shortfallKm}} km · 连续未达标第 {{item.failureStreak}} 月 · {{item.fundRatePerKm}} 元/km</view><view class="action-row"><button class="leave-btn" loading="{{actingId === item.memberId}}" data-id="{{item.memberId}}" data-resolution="leave" bindtap="resolveMissing">设为上月请假</button><button class="primary-btn approve-btn" loading="{{actingId === item.memberId}}" data-id="{{item.memberId}}" data-resolution="fund_paid" bindtap="resolveMissing">确认已缴公积金</button></view></view></view>
    <view wx:if="{{pendingFundPayments.length}}" class="queue-section fund-section"><view class="queue-count">待确认缴纳公积金 · {{pendingFundPayments.length}} 人</view><view class="missing-intro">成员已提交并完成审核，但跑量未达承诺；请核验到账后再确认。</view><view wx:for="{{pendingFundPayments}}" wx:key="memberId" class="card missing-card"><view class="member-head"><view class="avatar"><image wx:if="{{item.avatarUrl || item.avatarFileId}}" src="{{item.avatarUrl || item.avatarFileId}}" mode="aspectFill"/><text wx:else>{{item.displayName.slice(0,1)}}</text></view><view class="member-copy"><view>{{item.displayName}} <text wx:if="{{item.alias !== item.displayName}}">· {{item.alias}}</text></view><view>{{item.month}} · 已提交，未达承诺</view></view></view><view class="missing-metrics"><view><text>实际 / 承诺</text><view>{{item.actualText}}<text> / {{item.targetText}} km</text></view></view><view><text>应缴公积金</text><view class="fund-due">¥{{item.fundDueText}}</view></view></view><view class="fund-rule">缺口 {{item.shortfallKm}} km · 连续未达标第 {{item.failureStreak}} 月 · {{item.fundRatePerKm}} 元/km</view><button class="primary-btn fund-confirm-btn" loading="{{actingId === item.memberId}}" data-id="{{item.memberId}}" bindtap="confirmFundPayment">确认已缴公积金并计入余额</button></view></view>
  </view>

  <view wx:if="{{previewImageUrl}}" class="evidence-overlay">
    <view class="evidence-preview-panel">
      <image class="evidence-preview-image" src="{{previewImageUrl}}" mode="aspectFit" />
      <button class="evidence-close-btn" bindtap="closeEvidencePreview" aria-label="关闭截图">×</button>
    </view>
  </view>
</view>
