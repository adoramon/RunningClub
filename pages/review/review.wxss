.page-brand { display:flex; align-items:center; }.page-logo { width:58rpx; height:58rpx; margin-right:14rpx; }.title { margin:16rpx 0 24rpx; }
.tip { padding:20rpx; border-radius:14rpx; background:#EAF5ED; color:#356B4D; font-size:24rpx; margin-bottom:28rpx; }.tip text { color:#2D9A5C; margin-right:8rpx; }
.queue-section { margin-top:10rpx; }.missing-section,.fund-section { margin-top:38rpx; }.queue-count { margin:10rpx 0 16rpx; color:#6A786E; font-size:23rpx; font-weight:700; }.review-card,.missing-card { margin-bottom:20rpx; }.missing-intro { margin:-4rpx 0 18rpx; color:#7F8B83; font-size:21rpx; line-height:1.5; }
.member-head { display:flex; align-items:center; }.avatar { display:flex; align-items:center; justify-content:center; width:66rpx; height:66rpx; overflow:hidden; border-radius:50%; background:#DCECE2; color:#1F6F54; font-size:28rpx; font-weight:800; }.avatar image { width:100%; height:100%; }
.member-copy { flex:1; margin-left:16rpx; color:#265B43; font-size:28rpx; font-weight:800; }.member-copy view:last-child { margin-top:5rpx; color:#829087; font-size:20rpx; font-weight:400; }.confirmed-km { color:#176B47; font-size:34rpx; font-weight:900; }.confirmed-km text { font-size:19rpx; }
.proof-strip { display:flex; gap:10rpx; margin-top:22rpx; overflow:hidden; }.proof-thumbnail { flex:0 0 104rpx; width:104rpx; height:104rpx; border-radius:12rpx; background:#EFF4EF; }.proof-hint { margin-top:8rpx; color:#839087; font-size:19rpx; }
.activity-row { display:flex; align-items:flex-start; justify-content:space-between; padding:20rpx 0; border-bottom:1rpx solid #E8EFEA; }.activity-row.excluded { opacity:.46; }.activity-main { min-width:0; flex:1; padding-right:16rpx; }.activity-name { color:#275B45; font-size:25rpx; font-weight:800; }.activity-name text,.activity-evidence { color:#7E8A82; font-size:19rpx; font-weight:400; }.activity-evidence { max-width:390rpx; margin-top:6rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.raw-editor { display:flex; align-items:center; width:230rpx; height:56rpx; margin-top:12rpx; padding:0 12rpx; box-sizing:border-box; border-radius:10rpx; background:#F1F6F2; }.raw-editor input { min-width:0; flex:1; color:#265B43; font-size:24rpx; font-weight:800; }.raw-editor text { color:#78867D; font-size:19rpx; }.activity-side { display:flex; flex:0 0 148rpx; flex-direction:column; align-items:flex-end; }.activity-equivalent { color:#1F6F54; font-size:27rpx; font-weight:900; }.activity-equivalent text { font-size:18rpx; }.activity-toggle { min-width:106rpx; height:48rpx; margin:12rpx 0 0; padding:0 12rpx; border:1rpx solid #D6DED8; border-radius:999rpx; background:#FFF; color:#66756C; font-size:18rpx; line-height:46rpx; }.activity-toggle::after,.void-btn::after { border:none; }.activity-toggle.is-excluded { border-color:#BCD9C5; background:#EBF7EE; color:#28704B; }
.admin-total { display:flex; align-items:baseline; justify-content:space-between; margin-top:22rpx; padding:20rpx; border-radius:14rpx; background:#EAF5ED; color:#527361; font-size:22rpx; font-weight:700; }.admin-total view { color:#176B47; font-size:36rpx; font-weight:900; }.admin-total text { font-size:18rpx; }.void-area { margin-top:18rpx; padding:0 18rpx; border:1rpx solid #E6D4CD; border-radius:12rpx; background:#FFF9F7; }.void-area input { height:76rpx; color:#6A4B42; font-size:22rpx; }.action-row { display:flex; gap:14rpx; margin-top:20rpx; }.action-row button { margin:0; }.approve-btn { flex:1; }.void-btn { flex:0 0 220rpx; border:1rpx solid #E5BDB5; border-radius:14rpx; background:#FFF; color:#B64335; font-size:22rpx; font-weight:800; }
.missing-metrics { display:flex; gap:14rpx; margin-top:22rpx; }.missing-metrics > view { flex:1; padding:18rpx; border-radius:13rpx; background:#F4F7F3; color:#718076; font-size:19rpx; }.missing-metrics > view > view { margin-top:7rpx; color:#275B45; font-size:31rpx; font-weight:900; }.missing-metrics > view > view text { font-size:18rpx; }.missing-metrics .fund-due { color:#A87810; }.fund-rule { margin-top:15rpx; color:#8C7550; font-size:20rpx; }.leave-btn { flex:0 0 220rpx; border:1rpx solid #E6C58A; border-radius:14rpx; background:#FFF9E9; color:#9A6A17; font-size:22rpx; font-weight:800; }.leave-btn::after { border:none; }
.fund-confirm-btn { width:100%; margin-top:20rpx; }
.empty-state { padding:110rpx 0; text-align:center; }.empty-icon { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; margin:0 auto 18rpx; border-radius:50%; background:#DFF3E5; color:#1D8050; font-size:38rpx; font-weight:900; }.empty-title { margin-bottom:8rpx; color:#315F49; font-size:29rpx; font-weight:800; }
.evidence-overlay { position:fixed; z-index:999; top:0; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:center; padding:44rpx 32rpx; box-sizing:border-box; background:rgba(10,28,20,.78); }
.evidence-preview-panel { display:flex; width:100%; max-height:90vh; flex-direction:column; align-items:center; justify-content:center; }
.evidence-preview-image { width:100%; height:76vh; border-radius:20rpx; background:#101B16; box-shadow:0 20rpx 60rpx rgba(0,0,0,.28); }
.evidence-close-btn { display:flex; align-items:center; justify-content:center; width:82rpx; height:82rpx; margin:26rpx auto 0; padding:0; border:2rpx solid rgba(255,255,255,.72); border-radius:50%; background:rgba(255,255,255,.14); color:#FFF; font-size:56rpx; font-weight:300; line-height:78rpx; }
.evidence-close-btn::after { border:none; }
