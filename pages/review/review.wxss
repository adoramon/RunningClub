.page-brand { display:flex; align-items:center; }.page-logo { width:58rpx; height:58rpx; margin-right:14rpx; }.title { margin:16rpx 0 24rpx; }
.tip { padding:20rpx; border-radius:14rpx; background:#EAF5ED; color:#356B4D; font-size:24rpx; margin-bottom:28rpx; }.tip text { color:#2D9A5C; margin-right:8rpx; }
.queue-count { margin:10rpx 0 16rpx; color:#6A786E; font-size:23rpx; font-weight:700; }.review-card { margin-bottom:20rpx; }
.member-head { display:flex; align-items:center; }.avatar { display:flex; align-items:center; justify-content:center; width:66rpx; height:66rpx; overflow:hidden; border-radius:50%; background:#DCECE2; color:#1F6F54; font-size:28rpx; font-weight:800; }.avatar image { width:100%; height:100%; }
.member-copy { flex:1; margin-left:16rpx; color:#265B43; font-size:28rpx; font-weight:800; }.member-copy view:last-child { margin-top:5rpx; color:#829087; font-size:20rpx; font-weight:400; }.confirmed-km { color:#176B47; font-size:34rpx; font-weight:900; }.confirmed-km text { font-size:19rpx; }
.proof-strip { display:flex; gap:10rpx; margin-top:22rpx; overflow:hidden; }.proof-thumbnail { flex:0 0 104rpx; width:104rpx; height:104rpx; border-radius:12rpx; background:#EFF4EF; }
.activity-row { display:flex; align-items:center; justify-content:space-between; padding:20rpx 0; border-bottom:1rpx solid #E8EFEA; }.activity-name { color:#275B45; font-size:25rpx; font-weight:800; }.activity-name text,.activity-evidence { color:#7E8A82; font-size:19rpx; font-weight:400; }.activity-evidence { max-width:390rpx; margin-top:6rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.activity-value { color:#356B4D; font-size:24rpx; font-weight:800; text-align:right; }.activity-value view { margin-top:5rpx; color:#7D8B81; font-size:18rpx; font-weight:400; }
.approve-btn { margin-top:26rpx; }.empty-state { padding:110rpx 0; text-align:center; }.empty-icon { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; margin:0 auto 18rpx; border-radius:50%; background:#DFF3E5; color:#1D8050; font-size:38rpx; font-weight:900; }.empty-title { margin-bottom:8rpx; color:#315F49; font-size:29rpx; font-weight:800; }
