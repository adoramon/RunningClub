<view class="page">
  <view wx:if="{{profile}}"><view class="page-brand"><image class="page-logo" src="/assets/images/dongcheng-xijiu-logo.png" mode="aspectFit" /><view class="eyebrow">{{profileName}} · 历史跑量分析</view></view><view class="title">你的跑步节奏</view>
    <view class="stats"><view class="stat card"><text>{{profile.latestTargetKm === null ? '—' : profile.latestTargetKm}}</text><label>最近承诺 km</label></view><view class="stat card"><text>{{average}}</text><label>历史月均 km</label></view><view class="stat card"><text>{{best}}</text><label>历史最高 km</label></view></view>
    <view class="section-title">历史跑量数据</view><view class="card empty" wx:if="{{!records.length}}">历史台账中还没有你的有效跑量记录。</view>
    <view class="card history" wx:else><view class="history-grid"><view wx:for="{{records}}" wx:key="month" class="history-cell"><view class="history-tile {{item.statusClass}}"><view class="history-month">{{item.monthShort}}</view><view class="history-km">{{item.actualText}}<text wx:if="{{item.actualText !== '—'}}"> km</text></view><view class="history-status {{item.statusClass}}">{{item.statusLabel}}</view></view></view></view></view>
  </view>
  <view wx:else class="empty-state"><view class="page-brand"><image class="page-logo" src="/assets/images/dongcheng-xijiu-logo.png" mode="aspectFit" /><view class="eyebrow">DONGCHENG XIJIU</view></view><view class="title">从一个目标<br/>开始</view><view class="muted">完成登记后，即可查看个人跑量分析。</view><button class="primary-btn" bindtap="goRegister">登记承诺</button></view>
</view>
