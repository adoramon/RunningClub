.title { margin:14rpx 0 34rpx; }.stats { display:flex; gap:14rpx; }.stat { flex:1; padding:22rpx 12rpx; text-align:center; }.stat text { display:block; color:#1F6F54; font-size:37rpx; font-weight:800; }.stat label { display:block; margin-top:8rpx; font-size:20rpx; color:#788078; }.empty { color:#788078; font-size:26rpx; line-height:1.7; }.history-row { display:flex; align-items:center; justify-content:space-between; padding:20rpx 0; border-bottom:1rpx solid #F0F0EC; }.history-row:last-child { border:0; }.history-month { font-weight:800; }.history-km { font-weight:800; color:#1F6F54; font-size:34rpx; }.history-km text { font-size:22rpx; }.empty-state { padding-top:100rpx; }.empty-state .muted { margin-bottom:42rpx; }
