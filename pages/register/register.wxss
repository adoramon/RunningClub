.title { margin:16rpx 0; }.intro { margin-bottom:40rpx; }.form-card { padding:32rpx; }.field-label { color:#56625A; font-size:26rpx; font-weight:700; }.input { height:92rpx; border-bottom:2rpx solid #E7E8E3; font-size:32rpx; }.target-label { margin-top:38rpx; }.avatar-picker { width:112rpx; height:112rpx; margin:18rpx 0 0; padding:0; overflow:hidden; line-height:112rpx; border-radius:50%; background:#E4F0E9; color:#1F6F54; font-size:22rpx; }.avatar-picker::after { border:0; }.avatar-picker image { width:100%; height:100%; }.match-btn { margin:22rpx 0 0; color:#1F6F54; background:#E4F0E9; font-size:25rpx; }.match-btn::after { border:0; }.suggestions { margin-top:28rpx; }.suggestion { display:inline-block; margin:16rpx 16rpx 0 0; padding:12rpx 24rpx; border-radius:999rpx; background:#F1F3EF; }.suggestion.selected { background:#1F6F54; color:#FFF; }.save { margin-top:42rpx; }
