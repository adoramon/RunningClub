.register-brand { display:flex; align-items:center; }.register-logo { width:58rpx; height:58rpx; margin-right:14rpx; }.title { margin:16rpx 0; }.intro { margin-bottom:40rpx; }.form-card { padding:32rpx; }.field-label { color:#56625A; font-size:26rpx; font-weight:700; }.input { height:92rpx; border-bottom:2rpx solid #E7E8E3; font-size:32rpx; }.nickname-input { margin-top:8rpx; color:#1F6F54; }.nickname-hint { margin-top:12rpx; color:#879187; font-size:23rpx; line-height:1.6; }.target-label { margin-top:38rpx; }.avatar-picker { display:flex; flex:0 0 112rpx; align-items:center; justify-content:center; box-sizing:border-box; width:112rpx !important; min-width:0 !important; max-width:112rpx !important; height:112rpx !important; margin:18rpx 0 0; padding:0; overflow:hidden; line-height:1.2; border-radius:50% !important; background:#E4F0E9; color:#1F6F54; font-size:22rpx; }.avatar-picker::after { border:0; }.avatar-picker image { width:100%; height:100%; border-radius:50%; }.match-btn { margin:22rpx 0 0; color:#1F6F54; background:#E4F0E9; font-size:25rpx; }.match-btn::after { border:0; }.suggestions { margin-top:28rpx; }.suggestion { display:inline-block; margin:16rpx 16rpx 0 0; padding:12rpx 24rpx; border-radius:999rpx; background:#F1F3EF; }.suggestion.selected { background:#1F6F54; color:#FFF; }.save { margin-top:42rpx; }
