<view class="page">
  <view class="eyebrow">DONGCHENG XIJIU</view><view class="title">认领你的<br/>跑团身份</view>
  <view class="intro muted">请填写历史台账中的艺名。每个艺名只能绑定一个微信号。</view>
  <view class="card form-card">
    <view class="field-label">历史艺名</view><input class="input" placeholder="须与历史台账完全一致" value="{{name}}" data-field="name" bindinput="input" maxlength="12" />
    <view class="field-label target-label">微信头像（可选）</view><button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image wx:if="{{avatarPath}}" src="{{avatarPath}}" mode="aspectFill"/><text wx:else>选择头像</text></button>
  </view>
  <button class="primary-btn save" bindtap="save">{{claimed ? '确认当前身份' : '验证并绑定'}}</button>
</view>
