<view class="page">
  <view class="eyebrow">YOUR MONTHLY PROMISE</view><view class="title">给自己一个<br/>能完成的目标</view>
  <view class="intro muted">目标不是比较，而是帮助你稳定地跑下去。之后可随时回来更新。</view>
  <view class="card form-card">
    <view class="field-label">跑团昵称</view><input class="input" placeholder="例如：小北" value="{{name}}" data-field="name" bindinput="input" maxlength="12" />
    <view class="field-label target-label">本月承诺跑量</view><view class="distance-input"><input type="number" placeholder="0" value="{{target}}" data-field="target" bindinput="input" /><text>km</text></view>
  </view>
  <button class="primary-btn save" bindtap="save">{{editing ? '更新承诺' : '确认我的承诺'}}</button>
</view>
