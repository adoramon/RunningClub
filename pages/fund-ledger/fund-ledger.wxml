<view class="page">
  <view wx:if="{{ledger}}">
    <view class="page-brand"><image class="page-logo" src="/assets/images/dongcheng-xijiu-logo.png" mode="aspectFit"/><view><view class="eyebrow">DONGCHENG XIJIU</view><view class="page-name">公积金收支公示</view></view></view>
    <view class="balance-card"><view><view class="balance-label">当前公积金余额</view><view class="balance-value {{ledger.balance < 0 ? 'is-negative' : ''}}">¥{{ledger.balanceText}}</view></view><view class="balance-note">所有已确认的缴纳与支取<br/>均在下方公开留痕</view></view>
    <view class="summary-row"><view class="summary-item"><view>累计缴入</view><text>+¥{{ledger.incomeText}}</text></view><view class="summary-divider"></view><view class="summary-item"><view>累计支取</view><text>¥{{ledger.withdrawalText}}</text></view></view>
    <view wx:if="{{ledger.isAdmin}}" class="withdraw-card card"><view class="withdraw-title">管理员提取公积金</view><view class="withdraw-copy">仅跑团管理员可操作。金额与用途会立即向全体成员公示。</view><view class="field-label">提取金额（元）</view><input class="amount-input" type="digit" placeholder="例如 100.00" value="{{amount}}" data-field="amount" bindinput="input"/><view class="field-label">用途说明</view><textarea class="purpose-input" maxlength="100" placeholder="必填，例如：跑团活动物料" value="{{purpose}}" data-field="purpose" bindinput="input"/><button class="withdraw-button" loading="{{submitting}}" bindtap="withdraw">确认提取并公示</button></view>
    <view class="section-title">最近一个月收支明细</view><view class="ledger-note">{{ledger.recentMonthLabel}} · 逐笔展示原始流水；历史结转余额不属于支取。</view>
    <view wx:if="{{!ledger.recentEntries.length}}" class="card empty">该月没有已确认的公积金流水。</view>
    <view wx:else class="card ledger-list"><view wx:for="{{ledger.recentEntries}}" wx:key="entryId" class="ledger-entry"><view class="entry-main"><view class="entry-type">{{item.typeLabel}}</view><view class="entry-purpose">{{item.purpose}}</view><view class="entry-meta">{{item.dateLabel}}<text wx:if="{{item.operatorAlias}}"> · 经办：{{item.operatorAlias}}</text></view></view><view class="entry-amount {{item.direction}}">¥{{item.amountText}}</view></view></view>
    <view class="section-title">历史月度收支</view><view class="ledger-note">每格展示当月收入、支取与月末余额。</view>
    <view class="fund-years"><view wx:for="{{ledger.monthlyYears}}" wx:key="year" class="fund-year"><view class="fund-year-label">{{item.year}} 年</view><view class="fund-grid"><view wx:for="{{item.months}}" wx:key="month" class="fund-cell"><view wx:if="{{!item.placeholder}}" class="fund-tile {{item.toneClass}}"><view class="fund-month-bg">{{item.monthNumber}}月</view><view wx:if="{{item.openingText}}" class="fund-opening">期初 {{item.openingText}}</view><view class="fund-flow"><view>收 <text>{{item.incomeText}}</text></view><view>支 <text>{{item.expenseText}}</text></view></view><view class="fund-balance">余额 <text>¥{{item.balanceText}}</text></view></view><view wx:else class="fund-placeholder"><view class="fund-month-bg">{{item.monthNumber}}月</view></view></view></view></view></view>
  </view>
  <view wx:elif="{{loading}}" class="empty-state"><view class="muted">正在读取公积金公示…</view></view>
</view>
