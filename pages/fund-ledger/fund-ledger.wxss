.page-brand{display:flex;align-items:center;margin-bottom:24rpx}.page-logo{width:60rpx;height:60rpx;margin-right:14rpx}.page-name{margin-top:3rpx;color:#1B3125;font-size:31rpx;font-weight:900}.balance-card{display:flex;align-items:flex-end;justify-content:space-between;padding:32rpx;border-radius:24rpx;background:linear-gradient(135deg,#185F46,#287858);color:#FFF;box-shadow:0 12rpx 28rpx rgba(25,92,69,.18)}.balance-label{color:rgba(255,255,255,.72);font-size:23rpx}.balance-value{margin-top:10rpx;color:#B9F0C7;font-size:54rpx;font-weight:900}.balance-value.is-negative{color:#FFD0C7}.balance-note{color:rgba(255,255,255,.7);font-size:19rpx;line-height:1.65;text-align:right}.summary-row{display:flex;align-items:center;margin:20rpx 0 4rpx;padding:22rpx 16rpx;border-radius:18rpx;background:#EEF4EF}.summary-item{flex:1;color:#7D8B81;font-size:23rpx}.summary-item:first-child{text-align:left}.summary-item:last-child{text-align:right}.summary-item text{display:block;margin-top:6rpx;color:#1D6A4A;font-size:36rpx;font-weight:900}.summary-item:last-child text{color:#A24B3E}.summary-divider{width:1rpx;height:60rpx;background:#D7E2D9}.withdraw-card{margin-top:30rpx;border:1rpx solid #D9E8DC}.withdraw-title{color:#1E6248;font-size:31rpx;font-weight:900}.withdraw-copy{margin-top:8rpx;color:#758379;font-size:21rpx;line-height:1.6}.field-label{margin-top:26rpx;color:#526257;font-size:23rpx;font-weight:800}.amount-input,.purpose-input{box-sizing:border-box;width:100%;margin-top:10rpx;border-radius:13rpx;background:#F1F6F2;color:#1C5F43;font-size:29rpx}.amount-input{height:78rpx;padding:0 20rpx}.purpose-input{height:142rpx;padding:18rpx 20rpx}.withdraw-button{margin-top:24rpx;border-radius:14rpx;background:#1F6F54;color:#FFF;font-size:28rpx;font-weight:800}.withdraw-button::after{border:0}.section-title{margin-bottom:10rpx}.ledger-note{margin-bottom:16rpx;color:#89958D;font-size:20rpx;line-height:1.55}.ledger-list{padding:0 28rpx}.ledger-entry{display:flex;align-items:center;justify-content:space-between;padding:23rpx 0;border-bottom:1rpx solid #EEF0EC}.ledger-entry:last-child{border:0}.entry-main{min-width:0;flex:1;padding-right:14rpx}.entry-type{color:#203A2C;font-size:27rpx;font-weight:800}.entry-purpose{margin-top:5rpx;overflow:hidden;color:#637268;font-size:21rpx;text-overflow:ellipsis;white-space:nowrap}.entry-meta{margin-top:6rpx;color:#9AA49D;font-size:18rpx}.entry-amount{flex:0 0 auto;font-size:29rpx;font-weight:900}.entry-amount.income{color:#1B8053}.entry-amount.expense{color:#B54C3E}.entry-amount.neutral{color:#7C897F}.empty{color:#7D897F;font-size:24rpx}
.fund-years{margin-top:4rpx}.fund-year{margin-top:24rpx}.fund-year:first-child{margin-top:0}.fund-year-label{margin-bottom:12rpx;color:#355E49;font-size:28rpx;font-weight:900}.fund-grid{display:flex;flex-wrap:wrap;margin:-5rpx}.fund-cell{box-sizing:border-box;width:25%;padding:5rpx}.fund-tile,.fund-placeholder{position:relative;height:162rpx;overflow:hidden;border-radius:14rpx;padding:14rpx;box-sizing:border-box}.fund-tile{background:#EDF5EF}.fund-tile.status-deficit{background:#FFF0EA}.fund-placeholder{background:#F2F3F0}.fund-month-bg{position:absolute;right:8rpx;top:0;color:rgba(57,113,83,.12);font-size:42rpx;font-weight:900;line-height:1}.status-deficit .fund-month-bg,.fund-placeholder .fund-month-bg{color:rgba(171,86,64,.11)}.fund-opening{position:relative;color:#5D8870;font-size:16rpx;line-height:1.2}.fund-flow{position:relative;margin-top:28rpx;color:#637E6D;font-size:19rpx;line-height:1.45}.fund-opening + .fund-flow{margin-top:10rpx}.fund-flow text{font-size:23rpx;font-weight:900}.fund-flow view:first-child text{color:#278054}.fund-flow view:last-child text{color:#B65A47}.fund-balance{position:absolute;right:12rpx;bottom:12rpx;color:#738B7A;font-size:16rpx}.fund-balance text{color:#215E43;font-size:20rpx;font-weight:900}.status-deficit .fund-balance text{color:#AE4D3E}
