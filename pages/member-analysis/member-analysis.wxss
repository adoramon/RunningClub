.page-brand { display:flex; align-items:center; }
.member-avatar { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; margin-right:14rpx; overflow:hidden; border-radius:50%; background:#DCECE2; color:#1F6F54; font-weight:800; }
.member-avatar image { width:100%; height:100%; }
.unregistered { margin-top:4rpx; color:#9AA39B; font-size:19rpx; }
.title { margin:14rpx 0 34rpx; }
.stats { display:flex; gap:14rpx; }
.stats-secondary { margin-top:14rpx; }
.stat { flex:1; padding:22rpx 12rpx; text-align:left; }
.stat > text { display:block; color:#1F6F54; font-size:37rpx; font-weight:800; }
.stat-unit { display:inline; margin-left:4rpx; font-size:19rpx; font-weight:800; }
.stat label { display:block; margin-top:8rpx; color:#788078; font-size:20rpx; }
.stats-secondary .stat { padding:20rpx 14rpx; text-align:left; }
.stats-secondary .stat > text { font-size:34rpx; }
.stats-secondary .stat label { font-size:19rpx; }
.stat-total-km { background:#1F6F54; }
.stat-total-fund { background:#B65B2B; }
.stat-total-km > text,.stat-total-fund > text { color:#FFFFFF; }
.stat-total-km label,.stat-total-fund label { color:rgba(255,255,255,.78); }
.evaluation-card { position:relative; overflow:hidden; margin-top:20rpx; padding:24rpx; border-radius:20rpx; background:linear-gradient(135deg,#1E6B50 0%,#328365 57%,#5A9C77 100%); color:#FFF; box-shadow:0 12rpx 25rpx rgba(28,103,76,.16); }.evaluation-card::after { position:absolute; top:-46rpx; right:-26rpx; width:180rpx; height:180rpx; border:1rpx solid rgba(255,255,255,.16); border-radius:50%; content:''; }.evaluation-head { position:relative; z-index:1; display:flex; align-items:center; }.evaluation-mark { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; margin-right:14rpx; border-radius:17rpx; background:rgba(211,248,198,.2); color:#D5F6B4; font-size:31rpx; }.evaluation-eyebrow { color:rgba(232,255,238,.7); font-size:17rpx; font-weight:800; letter-spacing:2rpx; }.evaluation-title { margin-top:3rpx; font-size:30rpx; font-weight:900; }.evaluation-month { margin-left:auto; color:rgba(255,255,255,.72); font-size:19rpx; }.evaluation-content { position:relative; z-index:1; margin-top:22rpx; color:#FFF; font-size:25rpx; font-weight:600; line-height:1.75; }.evaluation-foot { position:relative; z-index:1; margin-top:18rpx; padding-top:14rpx; border-top:1rpx solid rgba(255,255,255,.2); color:rgba(239,255,243,.7); font-size:18rpx; }.evaluation-loading { margin-top:20rpx; padding:20rpx 24rpx; border-radius:16rpx; background:#EDF7F0; color:#5B8169; font-size:21rpx; }
.trend-card { margin-top:24rpx; padding:24rpx 20rpx 12rpx; overflow:hidden; background:linear-gradient(145deg,#FFFFFF 0%,#F0F8F3 100%); }
.trend-heading { display:flex; align-items:flex-start; justify-content:space-between; }
.trend-title { color:#245D45; font-size:30rpx; font-weight:900; }
.trend-note { margin-top:5rpx; color:#8A9C90; font-size:20rpx; }
.trend-chip { padding:7rpx 12rpx; border-radius:999rpx; background:#DDEFE3; color:#347857; font-size:19rpx; font-weight:800; }
.trend-canvas { display:block; width:100%; height:310rpx; margin-top:6rpx; }
.empty { color:#788078; font-size:26rpx; line-height:1.7; }
.history-years { margin-top:-4rpx; }
.history-year { margin-top:28rpx; }
.history-year:first-child { margin-top:0; }
.history-year-label { margin:0 0 12rpx 4rpx; color:#5E7566; font-size:30rpx; font-weight:900; }
.history-grid { display:flex; flex-wrap:wrap; margin:-5rpx; }
.history-cell { box-sizing:border-box; width:25%; padding:5rpx; }
.history-tile { position:relative; min-height:150rpx; overflow:hidden; padding:14rpx 10rpx; border:1rpx solid; border-radius:14rpx; }
.history-content { position:relative; z-index:1; padding-top:46rpx; }
.history-month-bg { position:absolute; top:4rpx; right:7rpx; color:rgba(255,255,255,.6); font-size:42rpx; font-weight:900; line-height:1; }
.history-km { color:#1F6F54; font-size:34rpx; font-weight:900; line-height:1.1; white-space:nowrap; }
.history-km text { font-size:17rpx; }
.history-bottom { position:absolute; z-index:2; right:10rpx; bottom:10rpx; left:10rpx; display:flex; align-items:flex-end; justify-content:space-between; }
.history-status-lines { font-size:22rpx; font-weight:900; line-height:1.02; }
.calendar-ring { display:flex; flex:0 0 54rpx; align-items:center; justify-content:center; width:54rpx; height:54rpx; border-radius:50%; }
.calendar-ring-core { display:flex; align-items:center; justify-content:center; width:40rpx; height:40rpx; border-radius:50%; background:rgba(255,255,255,.88); color:#426C53; font-size:13rpx; font-weight:900; }
.calendar-ring-core.ring-text-wide { font-size:11rpx; }
.history-tile.status-achieved .history-km,.history-status-lines.status-achieved,.history-tile.status-achieved .calendar-ring-core { color:#247346; }.history-tile.status-fund .history-km,.history-status-lines.status-fund,.history-tile.status-fund .calendar-ring-core { color:#A87810; }.history-tile.status-leave .history-km,.history-status-lines.status-leave,.history-tile.status-leave .calendar-ring-core { color:#C36E2E; }
.history-placeholder { position:relative; min-height:150rpx; overflow:hidden; border:1rpx solid #EEF1EE; border-radius:14rpx; background:#FAFBFA; }.history-placeholder .history-month-bg { color:#E3E9E3; }
.history-tile.status-achieved { border-color:#C8E7D2; background:#EAF7EE; }.history-tile.status-achieved .history-month-bg { color:#B4E1C1; }
.history-tile.status-fund { border-color:#F0D994; background:#FFF6D8; }.history-tile.status-fund .history-month-bg { color:#F4DEA4; }
.history-tile.status-leave { border-color:#F0CDAF; background:#FFF0E4; }.history-tile.status-leave .history-month-bg { color:#F6D1B6; }
.empty-state { padding-top:100rpx; }
