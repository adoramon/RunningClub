.profile-page { padding:28rpx 28rpx 50rpx; }
.personal-report { padding:30rpx; border-radius:28rpx; background:linear-gradient(135deg,#19583F,#237357); color:#FFF; }
.identity-row { display:flex; align-items:center; gap:16rpx; }
.member-avatar { flex-shrink:0; display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; border:2rpx solid rgba(255,255,255,.3); border-radius:50%; overflow:hidden; background:#DDEDE1; color:#245C42; font-size:30rpx; font-weight:700; }
.member-avatar image { width:100%; height:100%; }
.identity-copy { flex:1; min-width:0; }
.member-name { font-size:32rpx; font-weight:700; overflow-wrap:break-word; }
.identity-note { margin-top:7rpx; color:#B7D3C2; font-size:20rpx; line-height:1.5; }
.report-logo { width:50rpx; height:50rpx; flex-shrink:0; opacity:.7; }
.report-period { margin-top:34rpx; color:#C3DDCC; font-size:21rpx; letter-spacing:2rpx; }
.report-main { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:16rpx; }
.report-numbers { min-width:0; flex:1; }
.report-actual { font-size:62rpx; font-weight:800; letter-spacing:-1rpx; line-height:1.25; overflow-wrap:break-word; font-variant-numeric:tabular-nums; }
.report-actual text { font-size:23rpx; font-weight:500; color:#D1E7D8; letter-spacing:0; }
.report-target { margin-top:12rpx; color:#C8DDD1; font-size:22rpx; }
.report-status { display:inline-block; margin-top:16rpx; font-size:21rpx; color:#D7F4DF; }
.hero-ring { flex-shrink:0; width:160rpx; height:160rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; }
.hero-ring-core { width:136rpx; height:136rpx; border-radius:50%; background:#20694D; display:flex; flex-direction:column; justify-content:center; align-items:center; }
.hero-ring-core view { font-size:34rpx; font-weight:800; }
.hero-ring-core view text { font-size:18rpx; }
.hero-ring-core > text { color:#B7D8C4; font-size:18rpx; margin-top:5rpx; }
.report-reference { display:flex; gap:14rpx; padding-top:24rpx; margin-top:28rpx; border-top:1rpx solid rgba(255,255,255,.16); }
.report-reference > view { flex:1; min-width:0; }
.report-reference > view > text { font-size:28rpx; font-weight:650; overflow-wrap:break-word; }
.report-reference .unit { font-size:17rpx; color:#BFDBC9; font-weight:400; }
.report-reference label { display:block; margin-top:8rpx; color:#B3D0BE; font-size:19rpx; }
.lifetime-row { display:flex; gap:14rpx; margin-top:16rpx; }
.lifetime-row > view { flex:1; min-width:0; padding:25rpx 22rpx; border-radius:22rpx; }
.lifetime-distance { background:#1B634A; color:#FFF; }
.lifetime-fund { background:#F4EBDF; color:#945A32; }
.small-label { font-size:21rpx; opacity:.82; }
.lifetime-number { margin-top:15rpx; font-size:34rpx; line-height:1.3; font-weight:750; overflow-wrap:break-word; font-variant-numeric:tabular-nums; }
.lifetime-number text { font-size:20rpx; font-weight:500; }
.lifetime-caption { font-size:18rpx; margin-top:9rpx; opacity:.56; }
.evaluation-card { margin-top:20rpx; padding:28rpx; border-radius:22rpx; background:#EAF2E9; }
.evaluation-eyebrow { display:flex; justify-content:space-between; color:#7C9783; font-size:20rpx; }
.evaluation-title { margin-top:16rpx; color:#315F46; font-size:28rpx; font-weight:700; }
.evaluation-content { margin-top:12rpx; color:#4D6955; font-size:25rpx; line-height:1.85; }
.evaluation-foot { margin-top:18rpx; color:#8C9F90; font-size:18rpx; }
.trend-card { margin-top:26rpx; padding:28rpx 22rpx 20rpx; box-shadow:none; border:1rpx solid #E5EBE3; }
.block-title { color:#294E3B; font-size:30rpx; font-weight:750; }
.chart-legend { display:flex; align-items:center; gap:24rpx; margin-top:16rpx; font-size:19rpx; color:#7E9184; }
.chart-legend > view { display:flex; align-items:center; gap:8rpx; }
.legend-line { width:26rpx; height:0; border-top:4rpx solid #247557; }
.target-line { border-top:3rpx dashed #9BBBA6; }
.chart-unit { margin-left:auto; }
.trend-detail { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin-top:20rpx; padding:16rpx; background:#F4F7F1; border-radius:12rpx; font-size:19rpx; color:#6D8373; }
.trend-detail view { color:#2C674A; font-size:23rpx; font-weight:650; }
.trend-detail view text { font-size:18rpx; color:#8B9B8F; font-weight:400; }
.trend-canvas { display:block; width:100%; height:330rpx; margin-top:8rpx; }
.chart-caption { font-size:17rpx; color:#93A095; line-height:1.5; }
.history-heading { display:flex; align-items:center; justify-content:space-between; margin:34rpx 0 8rpx; }
.history-heading > text { font-size:19rpx; color:#93A095; }
.history-year { margin-top:14rpx; }
.year-heading { display:flex; align-items:center; justify-content:space-between; padding:22rpx 4rpx; }
.year-heading > view:first-child { color:#41664E; font-size:32rpx; font-weight:750; }
.year-heading > view:first-child text { margin-left:7rpx; font-size:20rpx; font-weight:400; }
.year-total { font-size:22rpx; color:#759080; }
.year-toggle { margin-left:18rpx; font-size:19rpx; color:#9AA79D; }
.history-grid { display:flex; flex-wrap:wrap; margin:-5rpx; }
.history-cell { box-sizing:border-box; width:25%; padding:5rpx; }
.history-tile { position:relative; min-height:150rpx; overflow:hidden; padding:14rpx 10rpx; border:1rpx solid; border-radius:14rpx; }
.history-content { position:relative; z-index:1; padding-top:46rpx; }
.history-month-bg { position:absolute; top:4rpx; right:7rpx; color:rgba(255,255,255,.6); font-size:42rpx; font-weight:900; line-height:1; }
.history-km { color:#1F6F54; font-size:34rpx; font-weight:900; line-height:1.1; white-space:nowrap; }
.history-km text { font-size:17rpx; }
.history-bottom { position:absolute; z-index:2; right:10rpx; bottom:10rpx; left:10rpx; display:flex; align-items:flex-end; justify-content:space-between; }
.history-status-lines { font-size:22rpx; font-weight:900; line-height:1.02; }
.calendar-ring { display:flex; flex:0 0 54rpx; align-items:center; justify-content:center; width:54rpx; height:54rpx; border-radius:50%; }
.calendar-ring-core { display:flex; align-items:center; justify-content:center; width:40rpx; height:40rpx; border-radius:50%; background:rgba(255,255,255,.88); color:#426C53; font-size:13rpx; font-weight:900; }
.calendar-ring-core.ring-text-wide { font-size:11rpx; }
.history-tile.status-achieved .history-km,.history-status-lines.status-achieved,.history-tile.status-achieved .calendar-ring-core { color:#247346; }.history-tile.status-fund .history-km,.history-status-lines.status-fund,.history-tile.status-fund .calendar-ring-core { color:#A87810; }.history-tile.status-leave .history-km,.history-status-lines.status-leave,.history-tile.status-leave .calendar-ring-core { color:#C36E2E; }.history-tile.status-missing .history-km,.history-status-lines.status-missing,.history-tile.status-missing .calendar-ring-core { color:#A9473F; }.history-status-lines.status-missing { font-size:19rpx; }
.history-placeholder { position:relative; min-height:150rpx; overflow:hidden; border:1rpx solid #EEF1EE; border-radius:14rpx; background:#FAFBFA; }.history-placeholder .history-month-bg { color:#E3E9E3; }
.history-tile.status-achieved { border-color:#C8E7D2; background:#EAF7EE; }.history-tile.status-achieved .history-month-bg { color:#B4E1C1; }
.history-tile.status-fund { border-color:#F0D994; background:#FFF6D8; }.history-tile.status-fund .history-month-bg { color:#F4DEA4; }
.history-tile.status-leave { border-color:#F0CDAF; background:#FFF0E4; }.history-tile.status-leave .history-month-bg { color:#F6D1B6; }
.history-tile.status-missing { border-color:#EAC5C0; background:#FFF0EE; }.history-tile.status-missing .history-month-bg { color:#F1CBC7; }

.page-foot { padding-top:38rpx; color:#A5B2A7; font-size:19rpx; text-align:center; }
.empty,.empty-state { color:#839184; font-size:24rpx; line-height:1.7; }
.empty-state { padding-top:100rpx; text-align:center; }
.month-overlay { position:fixed; z-index:1000; inset:0; background:rgba(17,37,27,.48); display:flex; align-items:flex-end; }
.month-panel { width:100%; box-sizing:border-box; padding:32rpx 32rpx calc(38rpx + env(safe-area-inset-bottom)); background:#FBFCF8; border-radius:30rpx 30rpx 0 0; }
.month-panel-heading { display:flex; align-items:center; justify-content:space-between; }
.month-panel-heading > view { color:#2C5D42; font-size:34rpx; font-weight:750; }
.month-panel-heading > view text { display:block; margin-top:8rpx; color:#879B8A; font-size:20rpx; font-weight:400; }
.month-panel-heading button { margin:0; padding:0; width:64rpx; height:64rpx; line-height:60rpx; background:#EDF2E9; border-radius:50%; color:#69846F; font-size:38rpx; }
.month-panel-heading button::after { border:none; }
.month-status { margin-top:24rpx; color:#387B54; font-size:24rpx; }
.status-missing { color:#A65F55; }
.status-leave { color:#BE874F; }
.status-fund { color:#9E832B; }
.month-metrics { display:flex; gap:16rpx; margin:24rpx 0; padding:24rpx 0; border-top:1rpx solid #E4EBE0; border-bottom:1rpx solid #E4EBE0; }
.month-metrics > view { flex:1; min-width:0; }
.month-metrics label { display:block; color:#8A9D8D; font-size:20rpx; }
.month-metrics text { display:block; margin-top:12rpx; color:#315C41; font-size:28rpx; font-weight:700; overflow-wrap:break-word; }
.month-review { color:#8C9C8D; font-size:22rpx; }
