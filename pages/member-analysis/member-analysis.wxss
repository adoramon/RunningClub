.page-brand { display:flex; align-items:center; }
.member-avatar { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; margin-right:14rpx; overflow:hidden; border-radius:50%; background:#DCECE2; color:#1F6F54; font-weight:800; }
.member-avatar image { width:100%; height:100%; }
.unregistered { margin-top:4rpx; color:#9AA39B; font-size:19rpx; }
.title { margin:14rpx 0 34rpx; }
.stats { display:flex; gap:14rpx; }
.stat { flex:1; padding:22rpx 12rpx; text-align:center; }
.stat text { display:block; color:#1F6F54; font-size:37rpx; font-weight:800; }
.stat label { display:block; margin-top:8rpx; color:#788078; font-size:20rpx; }
.empty { color:#788078; font-size:26rpx; line-height:1.7; }
.history { padding:12rpx; }
.history-grid { display:flex; flex-wrap:wrap; }
.history-cell { box-sizing:border-box; width:33.333%; padding:6rpx; }
.history-tile { min-height:142rpx; padding:16rpx 12rpx; border:1rpx solid #E9EEEA; border-radius:16rpx; background:#FAFCFA; }
.history-month { color:#6E7E73; font-size:24rpx; font-weight:800; }
.history-km { margin-top:10rpx; color:#1F6F54; font-size:32rpx; font-weight:900; line-height:1; }
.history-km text { font-size:18rpx; }
.history-status { display:inline-block; margin-top:12rpx; padding:4rpx 8rpx; border-radius:8rpx; font-size:18rpx; font-weight:700; }
.status-achieved { border-color:#CFE8D8; }.history-status.status-achieved { background:#E2F3E7; color:#237044; }
.status-fund { border-color:#F0DEAB; }.history-status.status-fund { background:#FFF2CF; color:#A87810; }
.status-leave { border-color:#F1D3B6; }.history-status.status-leave { background:#FFF0E2; color:#C36E2E; }
.empty-state { padding-top:100rpx; }
