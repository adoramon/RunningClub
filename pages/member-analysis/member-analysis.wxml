<view class="page profile-page">
  <view wx:if="{{profile}}">
    <view class="personal-report">
      <view class="identity-row">
        <view class="member-avatar"><image wx:if="{{profile.avatarUrl || profile.avatarFileId}}" src="{{profile.avatarUrl || profile.avatarFileId}}" mode="aspectFill"/><text wx:else>{{profileName.slice(0,1)}}</text></view>
        <view class="identity-copy"><view class="member-name">{{profileName}}</view><view class="identity-note">{{profile.alias !== profileName ? profile.alias + ' · ' : ''}}东成西就跑团<text wx:if="{{!profile.registered}}"> · 未注册</text></view></view>
        <image class="report-logo" src="/assets/images/dongcheng-xijiu-logo.png" mode="aspectFit"/>
      </view>
      <view class="report-period">{{latest.month}} · 上月运动战报</view>
      <view class="report-main">
        <view class="report-numbers"><view class="report-actual">{{latest.actualText}}<text> km</text></view><view class="report-target">实际跑量 / 承诺 {{latest.targetText}} km</view><view class="report-status">{{latest.statusLabel}}</view></view>
        <view class="hero-ring" style="{{latest.ringStyle}}"><view class="hero-ring-core"><view>{{latest.pctText}}<text wx:if="{{latest.pctText !== '—'}}">%</text></view><text>目标达成</text></view></view>
      </view>
      <view class="report-reference"><view><text>{{target}}<text class="unit"> km</text></text><label>最近承诺</label></view><view><text>{{average}}<text class="unit"> km</text></text><label>历史月均</label></view><view><text>{{best}}<text class="unit"> km</text></text><label>历史最高</label></view></view>
    </view>
    <view class="lifetime-row">
      <view class="lifetime-distance"><view class="small-label">一路累计跑过</view><view class="lifetime-number">{{totalKmText}}<text> km</text></view><view class="lifetime-caption">每一步，都算数</view></view>
      <view class="lifetime-fund"><view class="small-label">累计公积金贡献</view><view class="lifetime-number"><text>¥ </text>{{profile.totalFundAmountText}}</view><view class="lifetime-caption">与跑团一起成长</view></view>
    </view>
    <view wx:if="{{profile.monthlyEvaluation}}" class="evaluation-card">
      <view class="evaluation-eyebrow"><text>✦ 运动小结</text><text>{{evaluationMonth}}</text></view>
      <view class="evaluation-title">{{profile.monthlyEvaluation.title}}</view>
      <view class="evaluation-content">{{profile.monthlyEvaluation.content}}</view>
      <view class="evaluation-foot">{{profile.monthlyEvaluation.source === 'review_demo' ? '审核体验演示' : '基于该月运动数据生成'}} · AI 陪跑寄语</view>
    </view>
    <view class="card trend-card" wx:if="{{trendPoints.length}}">
      <view class="block-title">最近两年的跑量趋势</view>
      <view class="chart-legend"><view><text class="legend-line"></text>实际跑量</view><view><text class="legend-line target-line"></text>月度承诺</view><text class="chart-unit">km</text></view>
      <view class="trend-detail"><text>{{selectedTrend.month}}</text><view>{{selectedTrend.actualText}}<text> / {{selectedTrend.targetText}} km</text></view><text class="{{selectedTrend.statusClass}}">{{selectedTrend.statusLabel}}</text></view>
      <canvas id="trendCanvas" type="2d" class="trend-canvas" bindtouchstart="selectTrend"></canvas>
      <view class="chart-caption">轻点曲线查看月份 · 空心红点为无跑量记录，橙点为请假</view>
    </view>
    <view class="history-heading"><view class="block-title">历史跑量数据</view><text>点击月份查看详情</text></view>
    <view wx:if="{{!historyYears.length}}" class="card empty">还没有有效的历史跑量记录。</view>
    <view wx:for="{{historyYears}}" wx:key="year" class="history-year">
      <view class="year-heading" data-year="{{item.year}}" bindtap="toggleYear"><view>{{item.year}}<text>年</text></view><view class="year-total">{{item.totalText}} km<text class="year-toggle">{{item.expanded ? '收起 −' : '展开 ＋'}}</text></view></view>
      <view wx:if="{{item.expanded}}" class="history-grid"><view wx:for="{{item.months}}" wx:key="month" class="history-cell">
        <view wx:if="{{!item.placeholder}}" class="history-tile {{item.statusClass}}" data-month="{{item.month}}" bindtap="showMonth">
          <view class="history-month-bg">{{item.monthNumber}}月</view>
          <view class="history-content"><view class="history-km">{{item.actualText}}<text wx:if="{{item.actualText !== '—'}}"> km</text></view></view>
          <view class="history-bottom"><view class="history-status-lines {{item.statusClass}}"><view>{{item.statusTop}}</view><view>{{item.statusBottom}}</view></view><view class="calendar-ring" style="{{item.ringStyle}}"><view class="calendar-ring-core {{item.ringTextClass}}">{{item.actualText === '—' ? '—' : item.completionPct + '%'}}</view></view></view>
        </view>
        <view wx:else class="history-placeholder"><view class="history-month-bg">{{item.monthNumber}}月</view></view>
      </view></view>
    </view>
    <view class="page-foot">东成西就 · 一起把承诺跑成日常</view>
  </view>
  <view wx:elif="{{loading}}" class="empty-state">正在读取成员历史数据…</view>
  <view wx:else class="empty-state">暂时无法读取该成员的数据</view>
  <view wx:if="{{selectedMonth}}" class="month-overlay" bindtap="closeMonth">
    <view class="month-panel" catchtap="stopTap">
      <view class="month-panel-heading"><view>{{selectedMonth.month}}<text>月度记录</text></view><button bindtap="closeMonth" aria-label="关闭月度详情">×</button></view>
      <view class="month-status {{selectedMonth.statusClass}}">{{selectedMonth.statusLabel}}</view>
      <view class="month-metrics"><view><label>实际跑量</label><text>{{selectedMonth.actualText}} km</text></view><view><label>承诺跑量</label><text>{{selectedMonth.targetText}} km</text></view><view><label>目标达成</label><text>{{selectedMonth.pctText}}</text></view></view>
      <view class="month-review">{{selectedMonth.reviewLabel}}</view>
    </view>
  </view>
</view>
