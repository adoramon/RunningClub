<view class="page">
  <view wx:if="{{profile}}">
    <view class="page-brand">
      <view class="member-avatar"><image wx:if="{{profile.avatarFileId}}" src="{{profile.avatarFileId}}" mode="aspectFill"/><text wx:else>{{profileName.slice(0,1)}}</text></view>
      <view><view class="eyebrow">{{profileName}} · 个人跑量分析</view><view wx:if="{{!profile.registered}}" class="unregistered">○ 尚未注册</view></view>
    </view>
    <view class="title">{{profileName}}的跑步节奏</view>
    <view class="stats stats-primary"><view class="stat card"><text>{{profile.latestTargetKm === null ? '—' : profile.latestTargetKm}}<text wx:if="{{profile.latestTargetKm !== null}}" class="stat-unit"> km</text></text><label>最近承诺</label></view><view class="stat card"><text>{{average}}<text wx:if="{{average !== '—'}}" class="stat-unit"> km</text></text><label>历史月均</label></view><view class="stat card"><text>{{best}}<text wx:if="{{best !== '—'}}" class="stat-unit"> km</text></text><label>历史最高</label></view></view>
    <view class="stats stats-secondary"><view class="stat card stat-total-km"><text>{{profile.totalActualKm}}<text class="stat-unit"> km</text></text><label>累计跑量</label></view><view class="stat card stat-total-fund"><text>¥{{profile.totalFundAmountText}}</text><label>累计公积金贡献</label></view></view>
    <view wx:if="{{profile.monthlyEvaluation}}" class="evaluation-card"><view class="evaluation-head"><view class="evaluation-mark">✦</view><view><view class="evaluation-eyebrow">AI RUNNING NOTE</view><view class="evaluation-title">{{profile.monthlyEvaluation.title}}</view></view><view class="evaluation-month">{{profile.monthlyEvaluation.month}}</view></view><view class="evaluation-content">{{profile.monthlyEvaluation.content}}</view><view class="evaluation-foot">基于本月已确认提交数据生成 · 保持节奏，继续向前 🏃</view></view>
    <view class="trend-card card" wx:if="{{trendHasData}}"><view class="trend-heading"><view><view class="trend-title">最近两年的跑量趋势</view><view class="trend-note">按月实际跑量 · 无记录按 0 km 展示</view></view><view class="trend-chip">24 个月</view></view><canvas id="trendCanvas" type="2d" class="trend-canvas"></canvas></view>
    <view class="section-title">历史跑量数据</view>
    <view class="card empty" wx:if="{{!historyYears.length}}">历史台账中还没有该成员的有效跑量记录。</view>
    <view wx:else class="history-years"><view wx:for="{{historyYears}}" wx:key="year" class="history-year"><view class="history-year-label">{{item.year}} 年</view><view class="history-grid"><view wx:for="{{item.months}}" wx:key="month" class="history-cell"><view wx:if="{{!item.placeholder}}" class="history-tile {{item.statusClass}}"><view class="history-month-bg">{{item.monthNumber}}月</view><view class="history-content"><view class="history-km">{{item.actualText}}<text wx:if="{{item.actualText !== '—'}}"> km</text></view></view><view class="history-bottom"><view class="history-status-lines {{item.statusClass}}"><view>{{item.statusTop}}</view><view>{{item.statusBottom}}</view></view><view class="calendar-ring" style="{{item.ringStyle}}"><view class="calendar-ring-core {{item.ringTextClass}}">{{item.completionPct}}%</view></view></view></view><view wx:else class="history-placeholder"><view class="history-month-bg">{{item.monthNumber}}月</view></view></view></view></view></view>
  </view>
  <view wx:elif="{{loading}}" class="empty-state"><view class="muted">正在读取成员历史数据…</view></view>
  <view wx:else class="empty-state"><view class="title"><text>暂时无法读取</text><text>该成员的数据</text></view></view>
</view>
