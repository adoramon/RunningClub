<view class="page">
  <view wx:if="{{profile}}">
    <view class="page-brand">
      <view class="member-avatar"><image wx:if="{{profile.avatarFileId}}" src="{{profile.avatarFileId}}" mode="aspectFill"/><text wx:else>{{profileName.slice(0,1)}}</text></view>
      <view><view class="eyebrow">{{profileName}} · 个人跑量分析</view><view wx:if="{{!profile.registered}}" class="unregistered">○ 尚未注册</view></view>
    </view>
    <view class="title">{{profileName}}的跑步节奏</view>
    <view class="stats"><view class="stat card"><text>{{profile.inheritedTargetKm === null ? '—' : profile.inheritedTargetKm}}</text><label>本月继承承诺 km</label></view><view class="stat card"><text>{{average}}</text><label>历史月均 km</label></view><view class="stat card"><text>{{best}}</text><label>历史最高 km</label></view></view>
    <view class="section-title">历史记录</view>
    <view class="card empty" wx:if="{{!records.length}}">历史台账中还没有该成员的有效跑量记录。</view>
    <view class="card history" wx:else><view wx:for="{{records}}" wx:key="month" class="history-row"><view><view class="history-month">{{item.month}}</view><view class="muted">承诺 {{item.targetText}} km · {{item.actualNote}}</view></view><view class="history-km">{{item.actualText}}<text wx:if="{{item.actualText !== '—'}}"> km</text></view></view></view>
  </view>
  <view wx:elif="{{loading}}" class="empty-state"><view class="muted">正在读取成员历史数据…</view></view>
  <view wx:else class="empty-state"><view class="title">暂时无法读取<br/>该成员的数据</view></view>
</view>
